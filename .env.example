# 이 파일을 복사해서 ".env" 파일을 만들고 본인의 키를 넣으세요.
# .env 파일은 git에 올라가지 않습니다.

# 한국투자증권 Open API (실전투자용)
KIS_APP_KEY=
KIS_APP_SECRET=

# 실전투자 서버 주소 (기본값 그대로 두면 됩니다)
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# --- 아래는 M3(재료 엔진) 단계에서 사용 ---
# DART 오픈API 키 (https://opendart.fss.or.kr)
DART_API_KEY=

# 네이버 개발자센터 키 (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
